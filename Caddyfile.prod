# HotHoosh v2 - Caddy Production Config
# SSL: Caddy auto-issues Let's Encrypt cert for v2.hothoosh.ir
# Cloudflare: set SSL/TLS mode to "Full (Strict)"

v2.hothoosh.ir {
	reverse_proxy hothoosh:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}