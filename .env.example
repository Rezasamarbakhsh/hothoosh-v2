# ============================================
# HotHoosh v2 - Environment Variables
# ============================================
# cp .env.example .env
# nano .env
#

# --- Database (SQLite inside container) ---
DATABASE_URL="file:/app/data/hothoosh.db"

# --- NextAuth ---
NEXTAUTH_URL="https://v2.hothoosh.ir"
NEXTAUTH_SECRET=""
# Generate one: openssl rand -base64 48

# --- Optional: OAuth Providers ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_ID=""
# GITHUB_SECRET=""

# --- App ---
NODE_ENV="production"
PORT=3000