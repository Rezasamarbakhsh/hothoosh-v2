# ============================================
# HotHoosh v2 - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env
#

# --- Database (SQLite) ---
DATABASE_URL="file:/app/data/hothoosh.db"

# --- NextAuth ---
NEXTAUTH_URL="https://hothoosh.example.com"
NEXTAUTH_SECRET="change-me-to-a-random-64-char-string"

# --- Optional: OAuth Providers ---
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_ID=""
# GITHUB_SECRET=""

# --- App ---
NODE_ENV="production"
PORT=3000